---
import BaseHead from "../components/base-head.astro";
import Footer from "../components/footer.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  lang = "en",
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
    <head>
        <BaseHead title={title} description={description} />
    </head>
    <body class="font-sans">
        <a class="skip-link" href="#main-content">Skip to content</a>
        <main id="main-content">
            <slot />
        </main>
        <Footer />
        <script is:inline>
            const modelContext = document.modelContext ?? navigator.modelContext;

            if (modelContext) {
                const controller = new AbortController();
                const options = { signal: controller.signal };

                modelContext.registerTool({
                    name: "get_profile",
                    description: "Get Constantin Luckenbach's public professional profile, selected results, and canonical links.",
                    inputSchema: {
                        type: "object",
                        properties: {},
                        additionalProperties: false,
                    },
                    annotations: { readOnlyHint: true },
                    async execute() {
                        const response = await fetch("/api/profile");
                        return {
                            content: [{ type: "text", text: await response.text() }],
                        };
                    },
                }, options);

                modelContext.registerTool({
                    name: "navigate_site",
                    description: "Navigate the visible page to Constantin's home, work, or writing section.",
                    inputSchema: {
                        type: "object",
                        properties: {
                            destination: {
                                type: "string",
                                enum: ["home", "work", "writing"],
                                description: "The section to show in the current tab.",
                            },
                        },
                        required: ["destination"],
                        additionalProperties: false,
                    },
                    async execute({ destination }) {
                        const paths = { home: "/", work: "/work", writing: "/writing" };
                        location.assign(paths[destination]);
                        return {
                            content: [{ type: "text", text: `Navigating to ${destination}.` }],
                        };
                    },
                }, options);

                addEventListener("pagehide", () => controller.abort(), { once: true });
            }
        </script>
    </body>
</html>
<style>
    main {
        min-height: 100vh;
        padding: 2rem 1rem;
        max-width: 72rem;
        margin: 0 auto;
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

    @media (max-width: 480px) {
        main {
            padding: 1rem;
        }
    }
</style>
