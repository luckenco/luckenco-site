---
interface Props {
  locale?: "en" | "de";
}
const { locale = "en" } = Astro.props;
const SICHER_KI_URL = "https://sicher-ki.de";
const SICHER_KI_BOOKING_URL = "https://calendar.app.google/4BqgsoXJ7e7ULbH26";
const COPY = {
  ventureLabel: {
    en: "a luckenbach.io venture",
    de: "ein Unternehmen von luckenbach.io",
  },
  heading: {
    en: "Looking for help with AI?",
    de: "Genug mit KI herumexperimentiert?",
  },
  testimonialLabel: {
    en: "Here is what our customers say:",
    de: "Das sagen unsere Kunden:",
  },
  testimonialLead: {
    en: "52% fewer documents requiring manual review.",
    de: "52% weniger manuell zu prüfende Dokumente.",
  },
  testimonialBody: {
    en: "AI focuses on paperwork, leaving our team to handle only important exceptional cases.",
    de: "KI konzentriert sich auf Papierkram und unser Team muss nur noch wichtige Sonderfälle bearbeiten.",
  },
  bookConsultation: {
    en: "Free initial consultation",
    de: "Gratis Erstgespräch",
  },
  visitPage: {
    en: "Sicher-KI",
    de: "Sicher-KI",
  },
  philippRole: {
    en: "Co-founder adler.studio, software engineer, designer",
    de: "Mitgründer adler.studio, Software Engineer, Designer",
  },
  constantinRole: {
    en: "Software engineer, AI engineer, automation engineer",
    de: "Software Engineer, AI Engineer, Automation Engineer",
  },
} as const;
---
    <section
      aria-labelledby="sicher-ki-heading"
      class="callout"
    >
      <div class="callout-grid">
        <div class="team">
          <h2
            id="sicher-ki-heading"
            class="callout-title"
          >
            {COPY.heading[locale]}
          </h2>

          <div class="portraits">
            <article class="person">
              <img loading="lazy" decoding="async"
                src="/sicher-ki/philipp-parzer.webp"
                alt="Philipp Parzer"
                width={1024}
                height={1024}
                class="portrait"
              />
              <p class="person-name">
                Philipp Parzer
              </p>
              <p class="person-role">
                {COPY.philippRole[locale]}
              </p>
            </article>

            <article class="person">
              <img loading="lazy" decoding="async"
                src="/sicher-ki/constantin-luckenbach.webp"
                alt="Constantin Luckenbach"
                width={800}
                height={800}
                class="portrait"
              />
              <p class="person-name">
                Constantin Luckenbach
              </p>
              <p class="person-role">
                {COPY.constantinRole[locale]}
              </p>
            </article>
          </div>
        </div>

        <div class="customer">
          <div class="brand">
                <div
      aria-label="Sicher KI"
      class="wordmark"
    >
      <span class="wordmark-text">SICHER</span>

      <svg
        aria-hidden="true"
        class="wordmark-stars"
        viewBox="0 0 1321 2569"
        fill="none"
      >
        <path
          d="M385.575 2162.58L407.576 2231.01H478.773L421.173 2273.3L443.174 2341.73L385.575 2299.44L327.975 2341.73L349.976 2273.3L292.376 2231.01H363.573L385.575 2162.58Z"
          fill="currentColor"
        />
        <path
          d="M76.5303 2414.21L93.7124 2467.65H149.315L104.332 2500.68L121.514 2554.13L76.5303 2521.1L31.5469 2554.13L48.729 2500.68L3.74566 2467.65H59.3482L76.5303 2414.21Z"
          fill="currentColor"
        />
        <path
          d="M648.846 1820.78L679.164 1909.21H777.275L697.902 1963.86L728.22 2052.28L648.846 1997.63L569.473 2052.28L599.791 1963.86L520.418 1909.21H618.529L648.846 1820.78Z"
          fill="currentColor"
        />
        <path
          d="M887.691 1339.3L927.467 1453.34H1056.18L952.049 1523.82L991.825 1637.86L887.691 1567.38L783.558 1637.86L823.334 1523.82L719.2 1453.34H847.916L887.691 1339.3Z"
          fill="currentColor"
        />
        <path
          d="M1032.73 724.53L1084.21 884.622H1250.77L1116.02 983.565L1167.49 1143.66L1032.73 1044.71L897.982 1143.66L949.453 983.565L814.701 884.622H981.264L1032.73 724.53Z"
          fill="currentColor"
        />
        <path
          d="M1057.28 0L1116.47 184.112H1308.02L1153.05 297.9L1212.25 482.013L1057.28 368.225L902.306 482.013L961.499 297.9L806.529 184.112H998.083L1057.28 0Z"
          fill="currentColor"
        />
      </svg>

      <span class="wordmark-end">KI</span>
    </div>
            <span class="venture">
              {COPY.ventureLabel[locale]}
            </span>
          </div>

          <p class="testimonial-label">
            {COPY.testimonialLabel[locale]}
          </p>

          <a
            href="https://www.vertex.de/de/about/about-vertex/"
            target="_blank"
            aria-label="Christoph Grebe testimonial at Vertex"
            class="testimonial"
          >
            <figure class="quote">
              <svg
                aria-hidden="true"
                class="corner corner-start"
                viewBox="0 0 20 20"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M1 20V1H20" />
              </svg>

              <svg
                aria-hidden="true"
                class="corner corner-end"
                viewBox="0 0 20 20"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M19 0V19H0" />
              </svg>

              <img loading="lazy" decoding="async"
                src="/sicher-ki/testimonials/vertex-wordmark.webp"
                alt="Vertex"
                width={329}
                height={62}
                class="customer-logo"
              />

              <blockquote class="quote-text">
                <span class="quote-mark">
                  {locale === "de" ? "„" : "“"}
                </span>
                <strong>{COPY.testimonialLead[locale]}</strong>{" "}
                {COPY.testimonialBody[locale]}
                <span class="quote-mark">
                  ”
                </span>
              </blockquote>

              <figcaption class="attribution">
                <img loading="lazy" decoding="async"
                  src="/sicher-ki/testimonials/christoph-grebe.webp"
                  alt="Christoph Grebe"
                  width={460}
                  height={460}
                  class="customer-portrait"
                />
                <div class="customer-details">
                  <p class="customer-name">
                    Christoph Grebe
                  </p>
                  <p class="customer-role">CEO</p>
                  <p class="customer-role">Vertex GmbH</p>
                </div>
              </figcaption>
            </figure>
          </a>

          <div class="callout-actions">
            <a
              href={SICHER_KI_BOOKING_URL}
              target="_blank"
              class="consultation"
            >
              {COPY.bookConsultation[locale]}
              <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7M7 7h10v10" /></svg>
            </a>

            <a
              href={SICHER_KI_URL}
              target="_blank"
              class="visit"
            >
              {COPY.visitPage[locale]}
              <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7M7 7h10v10" /></svg>
            </a>
          </div>
        </div>
      </div>
    </section>

<style>
.callout {
  margin: 2rem auto 0;
  width: 100%;
  max-width: 980px;
  overflow: hidden;
  border: 1px solid #e4e4e7;
  background: #e4e4e7;
  color: #18181b;
}
.callout,
.callout * {
  box-sizing: border-box;
}
.callout p,
.callout h2,
.callout figure {
  margin: 0;
}
.callout-grid,
.team {
  display: grid;
}
.callout-title {
  display: flex;
  align-items: center;
  padding: 20px;
  border-bottom: 1px solid #e4e4e7;
  background: white;
  font-size: 30px;
  font-weight: 600;
  line-height: 1.05;
  letter-spacing: normal;
}
.portraits {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1px;
}
.person {
  display: flex;
  flex-direction: column;
  padding: 12px;
  background: #fafafa;
}
.portrait {
  display: block;
  aspect-ratio: 1;
  width: 100%;
  object-fit: cover;
  border-radius: 2px;
}
.callout .person-name {
  margin-top: 12px;
  font-size: 14px;
  font-weight: 600;
  line-height: 1.25;
}
.callout .person-role {
  margin-top: 4px;
  font-size: 12px;
  line-height: 1.375;
  color: #71717a;
}
.customer {
  padding: 24px;
  border-top: 1px solid #e4e4e7;
  background: #f7f7f8;
}
.brand {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 4px 12px;
}
.wordmark {
  display: inline-flex;
  align-items: center;
  font-size: 18px;
  line-height: 1;
}
.wordmark-text,
.wordmark-end {
  font-family: Arial, sans-serif;
  font-weight: 900;
}
.wordmark-end {
  transform: translateX(-2px);
}
.wordmark-stars {
  height: 36px;
  width: 20px;
  transform: translateX(-2px);
  overflow: visible;
}
.venture {
  font-size: 14px;
  color: #71717a;
}
.callout .testimonial-label {
  margin-top: 20px;
  font-size: 14px;
  font-weight: 500;
  color: #3f3f46;
}
.testimonial {
  display: block;
  width: 100%;
  margin-top: 12px;
  border: 0;
}
.testimonial:hover {
  border: 0;
}
.quote {
  position: relative;
  padding: 20px;
  background: white;
}
.corner {
  position: absolute;
  width: 20px;
  height: 20px;
  color: #001489;
  pointer-events: none;
}
.corner-start {
  top: 0;
  left: 0;
}
.corner-end {
  right: 0;
  bottom: 0;
}
.customer-logo {
  display: block;
  width: auto;
  height: 12px;
  max-width: 96px;
  object-fit: contain;
  object-position: left;
}
.quote-text {
  margin: 16px 0 0;
  padding: 0;
  border: 0;
  max-width: 34ch;
  font-size: 14px;
  font-weight: 500;
  line-height: 1.625;
  color: #3346ad;
}
.quote-mark {
  font-size: 1.25em;
  line-height: 1;
  color: #001489;
}
.attribution {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 16px;
}
.customer-portrait {
  width: 48px;
  height: 48px;
  flex-shrink: 0;
  border-radius: 2px;
  object-fit: cover;
}
.customer-details {
  min-width: 0;
  font-size: 12px;
  line-height: 1.25;
}
.customer-name {
  font-size: 14px;
  font-weight: 600;
}
.customer-role {
  color: #52525b;
  opacity: 0.6;
}
.callout-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 24px;
}
.callout-actions a {
  display: inline-flex;
  min-height: 48px;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 12px;
  white-space: nowrap;
  font-size: 14px;
  font-weight: 600;
  line-height: 1.5;
  transition: background-color 150ms;
}
.callout-actions svg {
  flex-shrink: 0;
}
.consultation {
  border: 1px solid transparent;
  background: #001489;
  color: white;
}
.consultation:hover {
  border-width: 1px;
  background: #00106f;
}
.visit {
  border: 1px solid #d4d4d8;
  background: white;
}
.visit:hover {
  border-width: 1px;
  background: #f4f4f5;
}
.testimonial:focus-visible,
.consultation:focus-visible {
  outline: 2px solid #001489;
  outline-offset: 2px;
}
@media (min-width: 640px) {
  .callout-title {
    padding: 28px;
    font-size: 36px;
  }
  .person {
    padding: 20px;
  }
  .callout .person-name {
    font-size: 16px;
  }
  .callout .person-role {
    font-size: 14px;
  }
  .customer {
    padding: 32px;
  }
  .quote-text {
    font-size: 16px;
  }
  .callout-actions {
    gap: 12px;
  }
  .callout-actions a {
    padding: 12px 20px;
    font-size: 16px;
  }
}
@media (min-width: 768px) {
  .callout-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .team {
    border-right: 1px solid #e4e4e7;
  }
  .callout-title {
    padding-top: 16px;
    padding-bottom: 16px;
  }
  .customer {
    border-top: 0;
  }
  .testimonial {
    max-width: 340px;
  }
}
</style>
